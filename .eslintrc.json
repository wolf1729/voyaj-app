{
  "extends": "universe/native",
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    ".expo/*",
    "node_modules/*",
    "android/*",
    "ios/*",
    "web-build/*"
  ]
}
